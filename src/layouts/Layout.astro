---
import { HeaderNav } from '../components/HeaderNav';
import FooterStatic from '../components/static/Footer.astro';
import DisclosureBannerStatic from '../components/static/DisclosureBanner.astro';
import { Analytics } from '@vercel/analytics/react';
import '../index.css';

interface Props {
  title?: string;
  description?: string;
  currentRoute?: { type: string; slug?: string };
  /** Optional JSON-LD structured data object(s) for this page. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'Groundwork: Unbiased Software Guides for Growing Businesses',
  description = 'Clear scorecards and unbiased software guides for growing small businesses. We test software independently with zero paid rankings.',
  currentRoute = { type: 'home' },
  jsonLd
} = Astro.props;

const cleanPath = Astro.url.pathname.replace(/\/$/, '');
const canonicalURL = new URL(cleanPath, Astro.site || 'https://groundworkforgrowth.vercel.app');
const SITE_URL = 'https://groundworkforgrowth.vercel.app';
const ogImage = `${SITE_URL}/og-image.png`;

// Site-wide WebApplication/WebSite schema, merged with any page-specific schema.
const siteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Groundwork',
  url: SITE_URL,
  description: 'Unbiased software guides and scorecards for growing small businesses.'
};
const jsonLdBlocks = [siteJsonLd, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="google-site-verification" content="yGq-gFJAaziwZwGATxguE3BP1o-_p06wtHpvLqgLa9s" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Twitter -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="Groundwork" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {jsonLdBlocks.map((block) => (
      <script type="application/ld+json" set:html={JSON.stringify(block)} />
    ))}

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400..700;1,9..144,400..700&family=IBM+Plex+Mono:wght@400;500;600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  </head>
  <body className="bg-[var(--paper)] text-[var(--ink)] antialiased min-h-screen flex flex-col">
    <div className="min-h-screen flex flex-col bg-[var(--paper)] text-[var(--ink)]">
      <!-- Site-wide Disclosure Banner (static) -->
      <DisclosureBannerStatic />

      <!-- Primary Navigation -->
      <HeaderNav client:load currentRoute={currentRoute} />

      <!-- Main Pre-rendered Static HTML Content -->
      <main className="flex-1">
        <slot />
      </main>

      <!-- Site Footer (static) -->
      <FooterStatic />

      <!-- Vercel Web Analytics -->
      <Analytics client:load />
    </div>
  </body>
</html>
