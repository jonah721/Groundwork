---
// Static category page: fully rendered to HTML at build time.
import Layout from '../../layouts/Layout.astro';
import ComparisonTableStatic from '../../components/static/ComparisonTable.astro';
import { CATEGORIES } from '../../data/categories';
import { getHref } from '../../utils/navigation';
import type { Category, SoftwareTool } from '../../types';

export async function getStaticPaths() {
  return CATEGORIES.map((cat) => ({
    params: { slug: cat.slug },
    props: { category: cat },
  }));
}

const { category } = Astro.props as { category: Category };
const hasSubsections = category.subsections && category.subsections.length > 0;

const SITE_URL = 'https://groundworkforgrowth.vercel.app';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ItemList',
  name: category.h1,
  description: category.intro,
  url: `${SITE_URL}/category/${category.slug}`,
  itemListElement: category.tools.map((t, i) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: t.name,
    url: `${SITE_URL}/review/${t.slug}`
  }))
};
---

<Layout
  title={`${category.h1} | Groundwork`}
  description={category.intro}
  currentRoute={{ type: 'category', slug: category.slug }}
  jsonLd={jsonLd}
>
  <div class="max-w-[1120px] mx-auto px-4 md:px-6 py-6 md:py-10 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 font-mono-data text-[0.78rem] text-[var(--ink-faint)]">
      <a href={getHref('home')} class="hover:text-[var(--ink)] flex items-center gap-1 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-[var(--line-strong)]"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-[var(--ink)] font-semibold truncate max-w-[200px] md:max-w-[300px]">{category.name}</span>
    </nav>

    <!-- Category Header -->
    <div id="category-overview" class="space-y-4 max-w-3xl">
      <div class="font-mono-data text-[0.78rem] font-bold text-[var(--moss-dark)] uppercase tracking-widest">
        {category.eyebrow}
      </div>
      <h1 class="text-display-h1 text-[var(--ink)]">
        {category.h1}
      </h1>
      <p class="text-[1.1rem] text-[var(--ink-soft)] leading-relaxed">
        {category.intro}
      </p>
    </div>

    <!-- Scope Redirects -->
    {category.scopeRedirects && category.scopeRedirects.length > 0 && (
      <div class="space-y-3 py-3 border-l-2 border-[var(--line-strong)] pl-4 text-[0.95rem] text-[var(--ink-soft)]">
        {category.scopeRedirects.map((sr) => (
          <p class="leading-relaxed">
            <strong class="text-[var(--ink)]">{sr.boldPrefix}</strong>
            {sr.text}
            {sr.targetCategorySlug ? (
              <a href={getHref('category', sr.targetCategorySlug)} class="font-bold text-[var(--moss-dark)] hover:underline cursor-pointer inline-block">
                {sr.linkText}
              </a>
            ) : (
              <strong class="text-[var(--ink)]">{sr.linkText}</strong>
            )}
            {sr.suffix}
          </p>
        ))}
      </div>
    )}

    {hasSubsections ? (
      <div class="space-y-16">
        {category.subsections!.map((sub, idx) => (
          <div class="space-y-8 pt-8 border-t border-[var(--line-strong)] first:border-0 first:pt-0">
            <div class="space-y-2">
              <div class="font-mono-data text-[0.75rem] font-bold text-[var(--moss-dark)] uppercase tracking-wider">
                SUBSECTION 0{idx + 1}
              </div>
              <h2 class="text-display-h2 text-[var(--ink)]">
                {sub.title}
              </h2>
              {sub.framing && (
                <p class="text-[1.05rem] text-[var(--ink-soft)] leading-relaxed max-w-3xl">
                  {sub.framing}
                </p>
              )}
            </div>

            {sub.criteria && (
              <div class="p-5 md:p-6 bg-[var(--moss-tint)] rounded-[10px] border border-[#CBD8CC]">
                <div class="font-mono-data text-[0.75rem] font-semibold tracking-wider uppercase text-[var(--moss-dark)] mb-3">
                  HOW WE SCORE THIS CATEGORY
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2.5 text-[0.92rem]">
                  {sub.criteria.map((item) => (
                    <div class="flex items-start gap-2 text-[var(--ink)]">
                      <span class="text-[var(--moss)] font-bold text-[1.1rem] leading-none select-none">&bull;</span>
                      <div>
                        <strong class="font-semibold text-[var(--ink)]">{item.name}</strong>
                        <span class="text-[var(--ink-soft)]"> - {item.definition}</span>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <div class="space-y-4">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-semibold text-[1.2rem] text-[var(--ink)]">
                  {sub.title}: Comparison Overview
                </h3>
                <span class="font-mono-data text-[0.8rem] text-[var(--ink-faint)] hidden sm:inline">
                  Scroll horizontally on mobile &rarr;
                </span>
              </div>

              <ComparisonTableStatic tools={sub.tools} />
            </div>

            {sub.oneThingCallout && (
              <div class="p-6 bg-[var(--ochre-tint)]/80 border-2 border-[var(--ochre)] rounded-[10px] space-y-3">
                <div class="flex items-center gap-2 text-[var(--ochre)] font-mono-data text-[0.8rem] font-bold uppercase tracking-wider">
                  <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
                  IF YOU ONLY DO ONE THING
                </div>
                <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)]">
                  {sub.oneThingCallout.heading}
                </h3>
                <p class="text-[0.95rem] text-[var(--ink-soft)] leading-relaxed">
                  {sub.oneThingCallout.body}
                </p>
                <div class="pt-2">
                  <a
                    href={getHref('review', sub.oneThingCallout.toolSlug)}
                    class="inline-flex items-center gap-1.5 font-mono-data text-[0.82rem] font-bold text-[var(--moss-dark)] hover:text-[var(--moss)] underline"
                  >
                    Read Top Recommendation Review &rarr;
                  </a>
                </div>
              </div>
            )}

            <div class="space-y-6 pt-2">
              <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)] border-b border-[var(--line)] pb-3">
                {sub.title}: Detailed Evaluations ({sub.tools.length} Tools)
              </h3>

              <div class="space-y-8">
                {sub.tools.map((tool: SoftwareTool) => (
                  <div class="p-6 md:p-8 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[10px] space-y-6 shadow-xs hover:border-[var(--moss)] transition-colors text-left">
                    <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 pb-4 border-b border-[var(--line)] text-left">
                      <div class="space-y-2 text-left">
                        <div class="flex items-center gap-3 flex-wrap text-left">
                          <h3 class="font-display font-semibold text-[1.5rem] text-[var(--ink)] text-left">
                            {tool.name}
                          </h3>
                          {tool.badge && (
                            <span class="inline-block font-mono-data text-[0.72rem] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full whitespace-nowrap bg-[var(--ochre)] text-white">
                              {tool.badge}
                            </span>
                          )}
                        </div>
                        <p class="text-[0.98rem] text-[var(--ink-soft)] max-w-2xl text-left">
                          {tool.tagline}
                        </p>
                      </div>

                      <div class="flex flex-col items-start md:items-end gap-2 shrink-0 text-left md:text-right">
                        <div class="inline-flex flex-col gap-1.5">
                          <div class="flex items-center gap-2">
                            <div class="flex items-center gap-[3px]">
                              {tool.scorecard.map((segment) => (
                                <div
                                  title={`${segment.label}: ${segment.passed ? 'Meets bar' : 'Needs improvement'}`}
                                  class={`w-[14px] h-[8px] rounded-[2px] transition-colors ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line)]'}`}
                                />
                              ))}
                            </div>
                            <span class="font-mono-data text-[0.78rem] text-[var(--ink-soft)] font-medium">
                              {tool.scorecard.filter((s) => s.passed).length}/{tool.scorecard.length}
                            </span>
                          </div>
                          <div class="grid grid-cols-2 gap-x-3 gap-y-1 mt-1 text-[0.78rem]">
                            {tool.scorecard.map((segment) => (
                              <div class="flex items-center gap-1.5">
                                <span class={`w-1.5 h-1.5 rounded-full ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line-strong)]'}`} />
                                <span class={`font-mono-data ${segment.passed ? 'text-[var(--ink)] font-medium' : 'text-[var(--ink-faint)]'}`}>
                                  {segment.label}
                                </span>
                              </div>
                            ))}
                          </div>
                        </div>
                        <div class="font-mono-data text-[0.85rem] text-[var(--ink-soft)]">
                          Starting at <strong class="text-[var(--ink)]">{tool.startingPrice}</strong>
                        </div>
                      </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                      <div class="p-5 bg-[var(--moss-tint)]/50 rounded-[10px] border border-[#CBD8CC]">
                        <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--moss-dark)] mb-3 flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--moss)]"><path d="M20 6 9 17l-5-5"/></svg>
                          PROS &amp; STRENGTHS
                        </h4>
                        <ul class="space-y-2 text-[0.92rem]">
                          {tool.pros.map((pro) => (
                            <li class="flex items-start gap-2 text-[var(--ink)]">
                              <span class="text-[var(--moss)] font-bold shrink-0 mt-0.5">&bull;</span>
                              <span>{pro}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                      <div class="p-5 bg-[#FDF2F0] rounded-[10px] border border-[#F2C9C2]">
                        <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--danger)] mb-3 flex items-center gap-1.5">
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--danger)]"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                          CONS &amp; LIMITATIONS
                        </h4>
                        <ul class="space-y-2 text-[0.92rem]">
                          {tool.cons.map((con) => (
                            <li class="flex items-start gap-2 text-[var(--ink)]">
                              <span class="text-[var(--danger)] font-bold shrink-0 mt-0.5">&bull;</span>
                              <span>{con}</span>
                            </li>
                          ))}
                        </ul>
                      </div>
                    </div>

                    <div class="flex items-center justify-between pt-2 flex-wrap gap-4 text-left">
                      <div class="font-mono-data text-[0.82rem] text-[var(--ink-soft)] text-left">
                        Best for: <strong class="text-[var(--ink)]">{tool.bestFor}</strong>
                      </div>
                      <div class="flex items-center gap-3 flex-wrap">
                        {(tool.affiliateUrl || tool.websiteUrl) && (
                          <a
                            href={tool.affiliateUrl || tool.websiteUrl}
                            target="_blank"
                            rel={tool.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}
                            class="inline-flex items-center gap-1.5 border border-[var(--moss)] text-[var(--moss-dark)] hover:bg-[var(--moss-tint)] font-mono-data text-[0.85rem] font-semibold px-4 py-2 rounded-[8px] transition-colors"
                          >
                            Visit Site
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                          </a>
                        )}
                        <a
                          href={getHref('review', tool.slug)}
                          class="inline-flex items-center gap-2 bg-[var(--moss)] hover:bg-[var(--moss-dark)] text-white font-mono-data text-[0.85rem] font-semibold px-5 py-2.5 rounded-[8px] transition-colors"
                        >
                          Read Full Evaluation
                          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                        </a>
                      </div>
                    </div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="space-y-10">
        {category.criteria && (
          <div class="p-5 md:p-6 bg-[var(--moss-tint)] rounded-[10px] border border-[#CBD8CC]">
            <div class="font-mono-data text-[0.75rem] font-semibold tracking-wider uppercase text-[var(--moss-dark)] mb-3">
              HOW WE SCORE THIS CATEGORY
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-2.5 text-[0.92rem]">
              {category.criteria.map((item) => (
                <div class="flex items-start gap-2 text-[var(--ink)]">
                  <span class="text-[var(--moss)] font-bold text-[1.1rem] leading-none select-none">&bull;</span>
                  <div>
                    <strong class="font-semibold text-[var(--ink)]">{item.name}</strong>
                    <span class="text-[var(--ink-soft)]"> - {item.definition}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        <div id="category-matrix" class="space-y-4">
          <div class="flex items-center justify-between">
            <h2 class="text-display-h2 text-[var(--ink)]">
              Category Comparison Overview
            </h2>
            <span class="font-mono-data text-[0.8rem] text-[var(--ink-faint)] hidden sm:inline">
              Scroll horizontally on mobile &rarr;
            </span>
          </div>

          <ComparisonTableStatic tools={category.tools} />
        </div>

        {category.oneThingCallout && (
          <div class="p-6 bg-[var(--ochre-tint)]/80 border-2 border-[var(--ochre)] rounded-[10px] space-y-3">
            <div class="flex items-center gap-2 text-[var(--ochre)] font-mono-data text-[0.8rem] font-bold uppercase tracking-wider">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 shrink-0"><path d="M15 14c.2-1 .7-1.7 1.5-2.5 1-.9 1.5-2.2 1.5-3.5A6 6 0 0 0 6 8c0 1 .2 2.2 1.5 3.5.7.7 1.3 1.5 1.5 2.5"/><path d="M9 18h6"/><path d="M10 22h4"/></svg>
              IF YOU ONLY DO ONE THING
            </div>
            <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)]">
              {category.oneThingCallout.heading}
            </h3>
            <p class="text-[0.95rem] text-[var(--ink-soft)] leading-relaxed">
              {category.oneThingCallout.body}
            </p>
            <div class="pt-2">
              <a
                href={getHref('review', category.oneThingCallout.toolSlug)}
                class="inline-flex items-center gap-1.5 font-mono-data text-[0.82rem] font-bold text-[var(--moss-dark)] hover:text-[var(--moss)] underline"
              >
                Read Top Recommendation Review &rarr;
              </a>
            </div>
          </div>
        )}

        <div id="category-tools" class="space-y-8 pt-4">
          <h2 class="text-display-h2 text-[var(--ink)] border-b border-[var(--line)] pb-3">
            Detailed Evaluations ({category.tools.length} Tools)
          </h2>

          <div class="space-y-8">
            {category.tools.map((tool) => (
              <div class="p-6 md:p-8 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[10px] space-y-6 shadow-xs hover:border-[var(--moss)] transition-colors text-left">
                <div class="flex flex-col md:flex-row md:items-start justify-between gap-4 pb-4 border-b border-[var(--line)] text-left">
                  <div class="space-y-2 text-left">
                    <div class="flex items-center gap-3 flex-wrap text-left">
                      <h3 class="font-display font-semibold text-[1.5rem] text-[var(--ink)] text-left">
                        {tool.name}
                      </h3>
                      {tool.badge && (
                        <span class="inline-block font-mono-data text-[0.72rem] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full whitespace-nowrap bg-[var(--ochre)] text-white">
                          {tool.badge}
                        </span>
                      )}
                    </div>
                    <p class="text-[0.98rem] text-[var(--ink-soft)] max-w-2xl text-left">
                      {tool.tagline}
                    </p>
                  </div>

                  <div class="flex flex-col items-start md:items-end gap-2 shrink-0 text-left md:text-right">
                    <div class="inline-flex flex-col gap-1.5">
                      <div class="flex items-center gap-2">
                        <div class="flex items-center gap-[3px]">
                          {tool.scorecard.map((segment) => (
                            <div
                              title={`${segment.label}: ${segment.passed ? 'Meets bar' : 'Needs improvement'}`}
                              class={`w-[14px] h-[8px] rounded-[2px] transition-colors ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line)]'}`}
                            />
                          ))}
                        </div>
                        <span class="font-mono-data text-[0.78rem] text-[var(--ink-soft)] font-medium">
                          {tool.scorecard.filter((s) => s.passed).length}/{tool.scorecard.length}
                        </span>
                      </div>
                      <div class="grid grid-cols-2 gap-x-3 gap-y-1 mt-1 text-[0.78rem]">
                        {tool.scorecard.map((segment) => (
                          <div class="flex items-center gap-1.5">
                            <span class={`w-1.5 h-1.5 rounded-full ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line-strong)]'}`} />
                            <span class={`font-mono-data ${segment.passed ? 'text-[var(--ink)] font-medium' : 'text-[var(--ink-faint)]'}`}>
                              {segment.label}
                            </span>
                          </div>
                        ))}
                      </div>
                    </div>
                    <div class="font-mono-data text-[0.85rem] text-[var(--ink-soft)]">
                      Starting at <strong class="text-[var(--ink)]">{tool.startingPrice}</strong>
                    </div>
                  </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  <div class="p-5 bg-[var(--moss-tint)]/50 rounded-[10px] border border-[#CBD8CC]">
                    <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--moss-dark)] mb-3 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--moss)]"><path d="M20 6 9 17l-5-5"/></svg>
                      PROS &amp; STRENGTHS
                    </h4>
                    <ul class="space-y-2 text-[0.92rem]">
                      {tool.pros.map((pro) => (
                        <li class="flex items-start gap-2 text-[var(--ink)]">
                          <span class="text-[var(--moss)] font-bold shrink-0 mt-0.5">&bull;</span>
                          <span>{pro}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                  <div class="p-5 bg-[#FDF2F0] rounded-[10px] border border-[#F2C9C2]">
                    <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--danger)] mb-3 flex items-center gap-1.5">
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--danger)]"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                      CONS &amp; LIMITATIONS
                    </h4>
                    <ul class="space-y-2 text-[0.92rem]">
                      {tool.cons.map((con) => (
                        <li class="flex items-start gap-2 text-[var(--ink)]">
                          <span class="text-[var(--danger)] font-bold shrink-0 mt-0.5">&bull;</span>
                          <span>{con}</span>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>

                <div class="flex items-center justify-between pt-2 flex-wrap gap-4 text-left">
                  <div class="font-mono-data text-[0.82rem] text-[var(--ink-soft)] text-left">
                    Best for: <strong class="text-[var(--ink)]">{tool.bestFor}</strong>
                  </div>
                  <div class="flex items-center gap-3 flex-wrap">
                    {(tool.affiliateUrl || tool.websiteUrl) && (
                      <a
                        href={tool.affiliateUrl || tool.websiteUrl}
                        target="_blank"
                        rel={tool.affiliateUrl ? 'noopener noreferrer sponsored' : 'noopener noreferrer'}
                        class="inline-flex items-center gap-1.5 border border-[var(--moss)] text-[var(--moss-dark)] hover:bg-[var(--moss-tint)] font-mono-data text-[0.85rem] font-semibold px-4 py-2 rounded-[8px] transition-colors"
                      >
                        Visit Site
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
                      </a>
                    )}
                    <a
                      href={getHref('review', tool.slug)}
                      class="inline-flex items-center gap-2 bg-[var(--moss)] hover:bg-[var(--moss-dark)] text-white font-mono-data text-[0.85rem] font-semibold px-5 py-2.5 rounded-[8px] transition-colors"
                    >
                      Read Full Evaluation
                      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
                    </a>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    )}
  </div>
</Layout>
