---
import Layout from '../../layouts/Layout.astro';
import { TOOLS } from '../../data/tools';
import { CATEGORIES } from '../../data/categories';
import { getHref } from '../../utils/navigation';
import type { SoftwareTool } from '../../types';

export async function getStaticPaths() {
  return TOOLS.map((tool) => ({
    params: { slug: tool.slug },
    props: { tool },
  }));
}

const { tool } = Astro.props as { tool: SoftwareTool };

// Find category and subsection peers for the "How it compares" mini table
const category = CATEGORIES.find(c => c.slug === tool.categorySlug);
let categoryPeers = TOOLS.filter(t => t.categorySlug === tool.categorySlug);
let groupTitle = tool.categoryName;

if (category && category.subsections) {
  const sub = category.subsections.find(s => s.tools.some(t => t.slug === tool.slug));
  if (sub) {
    categoryPeers = sub.tools;
    groupTitle = sub.title;
  }
}

const targetUrl = tool.affiliateUrl || tool.websiteUrl;
const isAffiliate = Boolean(tool.affiliateUrl);

const SITE_URL = 'https://groundworkforgrowth.vercel.app';
const scoreNum = parseFloat(tool.score) || 0;
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Product',
    name: tool.name,
    description: tool.tagline,
    url: `${SITE_URL}/review/${tool.slug}`,
    brand: { '@type': 'Brand', name: tool.name },
    ...(tool.websiteUrl ? { sameAs: tool.websiteUrl } : {}),
    review: {
      '@type': 'Review',
      name: `${tool.name} Evaluation & Review`,
      reviewBody: tool.verdict.summary,
      author: { '@type': 'Organization', name: 'Groundwork' },
      reviewRating: {
        '@type': 'Rating',
        ratingValue: String(Math.min(scoreNum, 5) || 4),
        bestRating: '5',
        worstRating: '1'
      },
      positiveNotes: {
        '@type': 'ItemList',
        itemListElement: tool.pros.map((p, i) => ({ '@type': 'ListItem', position: i + 1, name: p }))
      },
      negativeNotes: {
        '@type': 'ItemList',
        itemListElement: tool.cons.map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c }))
      }
    }
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: SITE_URL },
      { '@type': 'ListItem', position: 2, name: tool.categoryName, item: `${SITE_URL}/category/${tool.categorySlug}` },
      { '@type': 'ListItem', position: 3, name: tool.name, item: `${SITE_URL}/review/${tool.slug}` }
    ]
  }
];
---

<Layout
  title={`${tool.name} Evaluation & Review | Groundwork`}
  description={tool.tagline}
  currentRoute={{ type: 'review', slug: tool.slug }}
  jsonLd={jsonLd}
>
  <div class="max-w-[1120px] mx-auto px-4 md:px-6 py-6 md:py-10 space-y-12">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 font-mono-data text-[0.78rem] text-[var(--ink-faint)]">
      <a href={getHref('home')} class="hover:text-[var(--ink)] flex items-center gap-1 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-[var(--line-strong)]"><path d="m9 18 6-6-6-6"/></svg>
      <a href={getHref('category', tool.categorySlug)} class="hover:text-[var(--moss-dark)] transition-colors truncate max-w-[180px]">
        {tool.categoryName}
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-[var(--line-strong)]"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-[var(--ink)] font-semibold truncate max-w-[200px] md:max-w-[300px]">{tool.name} Review</span>
    </nav>

    <!-- Badge & H1 & Review Meta Line -->
    <div class="space-y-3 max-w-3xl">
      <div class="flex items-center gap-3 flex-wrap">
        {tool.badge && (
          <span class="inline-block font-mono-data text-[0.72rem] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full whitespace-nowrap bg-[var(--ochre)] text-white">
            {tool.badge}
          </span>
        )}
        <span class="font-mono-data text-[0.8rem] text-[var(--ink-faint)]">
          Reviewed August 2026 &middot; {tool.categoryName}
        </span>
        {targetUrl && (
          <a
            href={targetUrl}
            target="_blank"
            rel={isAffiliate ? "noopener noreferrer sponsored" : "noopener noreferrer"}
            class="inline-flex items-center gap-1.5 font-mono-data text-[0.78rem] font-bold text-[var(--moss-dark)] hover:text-[var(--moss)] bg-[var(--moss-tint)] border border-[#CBD8CC] hover:border-[var(--moss)] px-2.5 py-1 rounded-[6px] transition-all ml-auto sm:ml-0"
          >
            Visit {tool.name}
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
          </a>
        )}
      </div>

      <h1 class="text-display-h1 text-[var(--ink)]">
        {tool.name}
      </h1>

      <p class="text-[1.15rem] text-[var(--ink-soft)] font-medium leading-relaxed">
        {tool.tagline}
      </p>
    </div>

    <!-- The Problem It Solves & Who It's For Box -->
    <div id="review-summary" class="p-6 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[10px] space-y-4 shadow-xs">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="space-y-1.5">
          <span class="font-mono-data text-[0.72rem] font-bold text-[var(--moss-dark)] uppercase tracking-wider block">
            THE PROBLEM IT SOLVES
          </span>
          <p class="text-[0.98rem] text-[var(--ink)] leading-relaxed">
            {tool.overview}
          </p>
        </div>

        <div class="space-y-1.5 md:border-l md:border-[var(--line)] md:pl-6">
          <span class="font-mono-data text-[0.72rem] font-bold text-[var(--moss-dark)] uppercase tracking-wider block">
            WHO IT'S FOR
          </span>
          <p class="text-[0.98rem] text-[var(--ink)] leading-relaxed font-medium">
            {tool.verdict.targetPersona}
          </p>
        </div>
      </div>
    </div>

    <!-- Scorecard Bar -->
    <section id="review-scorecard" class="p-6 bg-[var(--paper-raised)] border border-[var(--line)] rounded-[10px] space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--line)] pb-4">
        <div>
          <span class="font-mono-data text-[0.72rem] font-bold uppercase text-[var(--moss-dark)] tracking-wider block mb-1">
            FULL EVALUATION SCORECARD
          </span>
          <h2 class="text-display-h2 text-[var(--ink)]">
            Binary Scoring Criteria ({tool.score})
          </h2>
        </div>
        <div class="inline-flex flex-col gap-1.5">
          <div class="flex items-center gap-2">
            <div class="flex items-center gap-[3px]">
              {tool.scorecard.map((segment) => (
                <div
                  title={`${segment.label}: ${segment.passed ? 'Meets bar' : 'Needs improvement'}${segment.detail ? ` (${segment.detail})` : ''}`}
                  class={`w-[14px] h-[8px] rounded-[2px] transition-colors ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line)]'}`}
                />
              ))}
            </div>
            <span class="font-mono-data text-[0.78rem] text-[var(--ink-soft)] font-medium">
              {tool.scorecard.filter(s => s.passed).length}/{tool.scorecard.length}
            </span>
          </div>
          <div class="grid grid-cols-2 gap-x-3 gap-y-1 mt-1 text-[0.78rem]">
            {tool.scorecard.map((segment) => (
              <div class="flex items-center gap-1.5">
                <span class={`w-1.5 h-1.5 rounded-full ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line-strong)]'}`} />
                <span class={`font-mono-data ${segment.passed ? 'text-[var(--ink)] font-medium' : 'text-[var(--ink-faint)]'}`}>
                  {segment.label}
                </span>
              </div>
            ))}
          </div>
        </div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 pt-2">
        {tool.scorecard.map((item) => (
          <div class={`p-4 rounded-[8px] border ${
            item.passed
              ? item.isStandout
                ? 'bg-[var(--ochre-tint)]/70 border-[var(--ochre)]'
                : 'bg-[var(--moss-tint)]/50 border-[#CBD8CC]'
              : 'bg-[#FDF2F0] border-[#F2C9C2]'
          }`}>
            <div class="flex items-center justify-between mb-1.5">
              <span class="font-mono-data font-bold text-[0.85rem] text-[var(--ink)]">
                {item.label}
              </span>
              <span class={`font-mono-data text-[0.72rem] font-bold px-2 py-0.5 rounded-full ${
                item.passed ? 'bg-[var(--moss)] text-white' : 'bg-[var(--danger)] text-white'
              }`}>
                {item.passed ? 'STRONG' : 'MODERATE'}
              </span>
            </div>
            <p class="text-[0.82rem] text-[var(--ink-soft)] leading-snug">
              {item.detail}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Pros & Cons -->
    <section id="review-pros-cons" class="space-y-3">
      <h2 class="text-display-h2 text-[var(--ink)]">
        Pros & Cons Analysis
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="p-5 bg-[var(--moss-tint)]/50 rounded-[10px] border border-[#CBD8CC]">
          <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--moss-dark)] mb-3 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--moss)]"><path d="M20 6 9 17l-5-5"/></svg>
            PROS & STRENGTHS
          </h4>
          <ul class="space-y-2 text-[0.92rem]">
            {tool.pros.map((pro) => (
              <li class="flex items-start gap-2 text-[var(--ink)]">
                <span class="text-[var(--moss)] font-bold shrink-0 mt-0.5">&bull;</span>
                <span>{pro}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="p-5 bg-[#FDF2F0] rounded-[10px] border border-[#F2C9C2]">
          <h4 class="font-mono-data text-[0.8rem] font-bold tracking-wider uppercase text-[var(--danger)] mb-3 flex items-center gap-1.5">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4 text-[var(--danger)]"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            CONS & LIMITATIONS
          </h4>
          <ul class="space-y-2 text-[0.92rem]">
            {tool.cons.map((con) => (
              <li class="flex items-start gap-2 text-[var(--ink)]">
                <span class="text-[var(--danger)] font-bold shrink-0 mt-0.5">&bull;</span>
                <span>{con}</span>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </section>

    <!-- How It Compares -->
    <section id="review-compares" class="space-y-4 text-left">
      <div class="space-y-1 text-left">
        <span class="font-mono-data text-[0.72rem] font-bold text-[var(--moss-dark)] uppercase tracking-wider block text-left">
          {groupTitle.toUpperCase()} COMPARISON
        </span>
        <h2 class="text-display-h2 text-[var(--ink)] text-left">
          How {tool.name} Compares to Alternatives
        </h2>
      </div>

      <div class="overflow-x-auto rounded-[10px] border border-[var(--line)] bg-[var(--paper-raised)]">
        <table class="w-full text-left border-collapse min-w-[640px]">
          <thead>
            <tr class="bg-[var(--paper)] border-b border-[var(--line)] font-mono-data text-[0.75rem] uppercase tracking-wider text-[var(--ink-soft)]">
              <th class="py-3 px-4 font-semibold">Tool</th>
              <th class="py-3 px-4 font-semibold">Starting Price</th>
              <th class="py-3 px-4 font-semibold">Setup Time</th>
              <th class="py-3 px-4 font-semibold">Best For</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--line)] text-[0.9rem]">
            {categoryPeers.map((peer) => {
              const isCurrentTool = peer.slug === tool.slug;
              return (
                <tr class={isCurrentTool ? 'bg-[var(--moss-tint)]/40 font-medium' : 'hover:bg-[var(--paper)]/50'}>
                  <td class="py-3.5 px-4 font-display font-semibold text-[var(--ink)] flex items-center gap-2">
                    {peer.name}
                    {peer.badge && (
                      <span class="inline-block font-mono-data text-[0.72rem] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full whitespace-nowrap bg-[var(--ochre)] text-white">
                        {peer.badge}
                      </span>
                    )}
                    {isCurrentTool && (
                      <span class="font-mono-data text-[0.7rem] bg-[var(--moss)] text-white px-2 py-0.5 rounded-full ml-auto">
                        THIS REVIEW
                      </span>
                    )}
                  </td>
                  <td class="py-3.5 px-4 font-mono-data text-[var(--ink)]">
                    {peer.startingPrice}
                  </td>
                  <td class="py-3.5 px-4 font-mono-data text-[var(--ink-soft)]">
                    {peer.setupTime}
                  </td>
                  <td class="py-3.5 px-4 text-[var(--ink-soft)]">
                    {peer.bestFor}
                  </td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Why We Picked It -->
    <section id="review-evaluation" class="p-6 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[10px] space-y-3">
      <h2 class="text-display-h2 text-[var(--ink)]">
        {tool.badge ? `Why We Picked It as ${tool.badge}` : 'Why We Picked It (And Who Should Pass)'}
      </h2>
      <p class="text-[1rem] text-[var(--ink-soft)] leading-relaxed">
        {tool.vsCompetitorsNote}
      </p>

      {tool.crossLink && (
        <div class="p-4 bg-[var(--paper)] rounded-[8px] border-l-4 border-[var(--moss)] text-[0.92rem] text-[var(--ink)] space-y-1 my-3">
          <p class="font-semibold text-[var(--ink)]">Also see:</p>
          <p class="text-[var(--ink-soft)]">{tool.crossLink.text}</p>
          <a
            href={getHref('review', tool.crossLink.targetSlug)}
            class="inline-flex items-center gap-1 font-mono-data text-[0.85rem] font-bold text-[var(--moss-dark)] hover:underline pt-1 cursor-pointer inline-block"
          >
            {tool.crossLink.linkText}
          </a>
        </div>
      )}

      <div class="p-4 bg-[var(--paper)] rounded-[8px] border border-[var(--line)] text-[0.92rem] text-[var(--ink-soft)] space-y-1">
        <p><strong class="text-[var(--danger)]">Who Should Look Elsewhere: </strong>{tool.verdict.whoShouldAvoid}</p>
        <p><strong class="text-[var(--moss-dark)]">Recommended Alternative: </strong>{tool.verdict.alternativeSuggestion}</p>
      </div>
    </section>

    <!-- Pricing Snapshot -->
    <section id="review-pricing" class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[var(--line)] pb-3">
        <h2 class="text-display-h2 text-[var(--ink)]">
          Pricing Snapshot & Tiers
        </h2>
        <span class="font-mono-data text-[0.78rem] text-[var(--ink-faint)]">
          {tool.pricingDetail}
        </span>
      </div>

      <div class="overflow-x-auto rounded-[10px] border border-[var(--line)] bg-[var(--paper-raised)]">
        <table class="w-full text-left border-collapse min-w-[600px]">
          <thead>
            <tr class="bg-[var(--paper)] border-b border-[var(--line)] font-mono-data text-[0.75rem] uppercase tracking-wider text-[var(--ink-soft)]">
              <th class="py-3 px-4 font-semibold">Tier Name</th>
              <th class="py-3 px-4 font-semibold">Price</th>
              <th class="py-3 px-4 font-semibold">Key Capabilities</th>
              <th class="py-3 px-4 font-semibold">Best Fit</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-[var(--line)] text-[0.9rem]">
            {tool.pricingTiers.map((tier) => (
              <tr class="hover:bg-[var(--paper)]/50">
                <td class="py-3.5 px-4 font-display font-semibold text-[var(--ink)]">
                  {tier.name}
                </td>
                <td class="py-3.5 px-4 font-mono-data font-bold text-[var(--moss-dark)]">
                  {tier.price}
                </td>
                <td class="py-3.5 px-4 text-[var(--ink-soft)]">
                  {tier.features}
                </td>
                <td class="py-3.5 px-4 font-mono-data text-[0.82rem] text-[var(--ink-faint)]">
                  {tier.bestFor}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <p class="font-mono-data text-[0.78rem] text-[var(--ink-faint)] italic">
        * Pricing current as of review date; confirm on {tool.name}'s official site before purchasing.
      </p>
    </section>

    <!-- Key Capabilities Deep Dive -->
    <section class="space-y-4">
      <h2 class="text-display-h2 text-[var(--ink)] border-b border-[var(--line)] pb-2">
        Key Capabilities & Features
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {tool.keyFeatures.map((feat) => (
          <div class="p-5 bg-[var(--paper-raised)] rounded-[10px] border border-[var(--line)] space-y-2">
            <h3 class="font-display font-semibold text-[1.1rem] text-[var(--ink)]">
              {feat.title}
            </h3>
            <p class="text-[0.92rem] text-[var(--ink-soft)] leading-relaxed">
              {feat.description}
            </p>
          </div>
        ))}
      </div>
    </section>

    <!-- Verdict Box -->
    <section class="pt-4">
      <div class="p-6 md:p-8 bg-[var(--ink)] text-white rounded-[10px] shadow-md border border-[var(--ink)]">
        <div class="font-mono-data text-[0.75rem] font-semibold tracking-wider uppercase text-white/70 mb-3">
          THE VERDICT
        </div>

        <h3 class="font-display text-[1.4rem] font-semibold text-white mb-3">
          Is {tool.name} Right for You?
        </h3>

        <p class="text-white/90 text-[1.02rem] leading-relaxed mb-4">
          {tool.verdict.summary}
        </p>

        <div class="p-4 bg-white/5 rounded-[8px] border border-white/10 mb-6 space-y-2 text-[0.92rem]">
          <div>
            <strong class="text-[var(--ochre-tint)] font-semibold">Recommended for: </strong>
            <span class="text-white/80">{tool.verdict.targetPersona}</span>
          </div>
          <div>
            <strong class="text-[var(--danger)]/90 font-semibold">Who should look elsewhere: </strong>
            <span class="text-white/80">{tool.verdict.whoShouldAvoid} ({tool.verdict.alternativeSuggestion})</span>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row sm:items-center gap-4 flex-wrap pt-2 border-t border-white/10">
          <div class="flex flex-col gap-1.5">
            <a
              href={targetUrl || `#pricing-${tool.slug}`}
              target={targetUrl ? '_blank' : '_self'}
              rel={targetUrl ? (isAffiliate ? 'noopener noreferrer sponsored' : 'noopener noreferrer') : undefined}
              class="inline-flex items-center gap-2 bg-[var(--moss)] hover:bg-[var(--moss-dark)] text-white font-mono-data text-[0.85rem] font-semibold px-5 py-2.5 rounded-[8px] transition-colors w-fit"
            >
              {tool.ctaText || (targetUrl ? `Visit ${tool.name} Official Site` : `View Plans & Starting Price (${tool.startingPrice})`)}
              {targetUrl ? (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M15 3h6v6"/><path d="M10 14 21 3"/><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/></svg>
              ) : (
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              )}
            </a>

            {tool.affiliateUrl && tool.websiteUrl && (
              <a
                href={tool.websiteUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-white/60 hover:text-white font-mono-data text-[0.78rem] underline underline-offset-2"
              >
                Direct non-affiliate link: {tool.websiteUrl}
              </a>
            )}

            {tool.ctaNote && (
              <span class="font-mono-data text-[0.78rem] text-white/70 italic">
                ({tool.ctaNote})
              </span>
            )}
          </div>

          <a
            href={getHref('category', tool.categorySlug)}
            class="inline-flex items-center gap-1.5 text-white/70 hover:text-white font-mono-data text-[0.82rem] underline underline-offset-4 transition-colors sm:ml-auto"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
            Back to Comparison Table
          </a>
        </div>
      </div>
    </section>
  </div>
</Layout>
