---
// Static hub page: fully rendered to HTML at build time.
import Layout from '../../layouts/Layout.astro';
import { PROBLEM_HUBS } from '../../data/hubs';
import { TOOLS } from '../../data/tools';
import { CATEGORIES } from '../../data/categories';
import { getHref } from '../../utils/navigation';
import type { ProblemHub } from '../../types';

export async function getStaticPaths() {
  return PROBLEM_HUBS.map((hub) => ({
    params: { slug: hub.slug },
    props: { hub },
  }));
}

const { hub } = Astro.props as { hub: ProblemHub };
const category = CATEGORIES.find((c) => c.slug === hub.categorySlug) || CATEGORIES[0];
const matchingTools = TOOLS.filter((t) => hub.recommendedToolSlugs.includes(t.slug));

const SITE_URL = 'https://groundworkforgrowth.vercel.app';
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: hub.title,
  description: hub.description,
  url: `${SITE_URL}/hub/${hub.slug}`,
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: hub.recommendedToolSlugs.map((slug, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      url: `${SITE_URL}/review/${slug}`
    }))
  }
};
---

<Layout
  title={`${hub.title} | Groundwork Problem Navigator`}
  description={hub.description}
  currentRoute={{ type: 'hub', slug: hub.slug }}
  jsonLd={jsonLd}
>
  <div class="max-w-[1120px] mx-auto px-4 md:px-6 py-6 md:py-10 space-y-10">
    <!-- Breadcrumbs -->
    <nav class="flex items-center gap-1.5 font-mono-data text-[0.78rem] text-[var(--ink-faint)]">
      <a href={getHref('home')} class="hover:text-[var(--ink)] flex items-center gap-1 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Home
      </a>
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3 h-3 text-[var(--line-strong)]"><path d="m9 18 6-6-6-6"/></svg>
      <span class="text-[var(--ink)] font-semibold truncate max-w-[200px] md:max-w-[300px]">Problem {hub.num}: {hub.hubLabel}</span>
    </nav>

    <!-- Header -->
    <div id="hub-diagnosis" class="space-y-4 max-w-3xl text-left">
      <div class="font-mono-data text-[0.78rem] font-bold text-[var(--moss-dark)] uppercase tracking-widest flex items-center gap-2 text-left">
        <span class="px-2 py-0.5 bg-[var(--moss-tint)] border border-[#CBD8CC] rounded-full">
          BUSINESS PROBLEM {hub.num}
        </span>
        <span>{hub.hubLabel}</span>
      </div>

      <h1 class="text-display-h1 text-[var(--ink)]">
        {hub.title}
      </h1>

      <p class="text-[1.1rem] text-[var(--ink-soft)] leading-relaxed">
        {hub.description}
      </p>
    </div>

    <!-- Solution Category Options / Branches -->
    {hub.categoryBranches && hub.categoryBranches.length > 0 ? (
      <div class="space-y-4 p-6 bg-[var(--moss-tint)] border border-[#CBD8CC] rounded-[10px]">
        <div class="space-y-1">
          <span class="font-mono-data text-[0.72rem] font-bold uppercase text-[var(--moss-dark)] tracking-wider block">
            SOLUTION CATEGORIES BY BUSINESS TYPE
          </span>
          <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)]">
            Choose the category that matches how your customers engage with you
          </h3>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 pt-2">
          {hub.categoryBranches.map((branch) => (
            <div class="p-4 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[8px] flex flex-col justify-between space-y-3">
              <div class="space-y-1.5">
                <div class="font-mono-data text-[0.75rem] font-bold text-[var(--moss-dark)] uppercase">
                  {branch.label}
                </div>
                <h4 class="font-display font-semibold text-[1.05rem] text-[var(--ink)]">
                  {branch.categoryName}
                </h4>
                <p class="text-[0.85rem] text-[var(--ink-soft)] leading-snug">
                  {branch.description}
                </p>
              </div>

              <a
                href={getHref('category', branch.categorySlug)}
                class="inline-flex items-center gap-1.5 font-mono-data text-[0.82rem] font-bold text-[var(--moss-dark)] hover:text-[var(--moss)] underline pt-1"
              >
                View Category &rarr;
              </a>
            </div>
          ))}
        </div>
      </div>
    ) : (
      <div class="p-6 bg-[var(--moss-tint)] border border-[#CBD8CC] rounded-[10px] flex flex-col md:flex-row md:items-center justify-between gap-4">
        <div>
          <span class="font-mono-data text-[0.72rem] font-bold uppercase text-[var(--moss-dark)] tracking-wider block mb-1">
            CORE SOLUTION CATEGORY
          </span>
          <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)]">
            {category.name}
          </h3>
          <p class="text-[0.92rem] text-[var(--ink-soft)] mt-1">
            {category.intro}
          </p>
        </div>

        <a
          href={getHref('category', category.slug)}
          class="shrink-0 bg-[var(--moss-dark)] hover:bg-[var(--moss)] text-white font-mono-data text-[0.85rem] font-semibold px-5 py-3 rounded-[8px] transition-colors flex items-center gap-2"
        >
          View Category Guide
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-4 h-4"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </div>
    )}

    <!-- Quick Wins List -->
    <div class="p-6 bg-[var(--paper-raised)] border border-[var(--line-strong)] rounded-[10px] space-y-4">
      <h2 class="font-display font-semibold text-[1.3rem] text-[var(--ink)] flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5 text-[var(--moss)]"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
        3 Immediate Operational Quick Wins
      </h2>

      <div class="space-y-3 text-[0.95rem]">
        {hub.quickWins.map((win, idx) => (
          <div class="flex items-start gap-3 p-3 bg-[var(--paper)] rounded-[6px] border border-[var(--line)]">
            <span class="font-mono-data font-bold text-[var(--moss-dark)] shrink-0 text-[0.88rem]">
              0{idx + 1}.
            </span>
            <span class="text-[var(--ink)] leading-relaxed">{win}</span>
          </div>
        ))}
      </div>
    </div>

    <!-- Recommended Tools -->
    <div id="hub-stack" class="space-y-6">
      <h2 class="text-display-h2 text-[var(--ink)] border-b border-[var(--line)] pb-3">
        Top Software Tools Addressing This Bottleneck
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {matchingTools.map((tool) => (
          <div class="p-6 bg-[var(--paper-raised)] border border-[var(--line)] rounded-[10px] space-y-4 flex flex-col justify-between shadow-xs">
            <div class="space-y-3">
              <div class="flex items-center justify-between">
                <h3 class="font-display font-semibold text-[1.25rem] text-[var(--ink)]">
                  {tool.name}
                </h3>
                {tool.badge && (
                  <span class="inline-block font-mono-data text-[0.72rem] font-semibold tracking-wider uppercase px-2.5 py-0.5 rounded-full whitespace-nowrap bg-[var(--ochre)] text-white">
                    {tool.badge}
                  </span>
                )}
              </div>

              <p class="text-[0.92rem] text-[var(--ink-soft)] leading-relaxed">
                {tool.tagline}
              </p>

              <div class="p-3 bg-[var(--paper)] rounded-[6px] border border-[var(--line)] text-[0.88rem]">
                <strong class="text-[var(--ink)]">Target Persona: </strong>
                <span class="text-[var(--ink-soft)]">{tool.bestFor}</span>
              </div>
            </div>

            <div class="pt-3 border-t border-[var(--line)] flex items-center justify-between">
              <div class="flex items-center gap-2">
                <div class="flex items-center gap-[3px]">
                  {tool.scorecard.map((segment) => (
                    <div
                      title={`${segment.label}: ${segment.passed ? 'Meets bar' : 'Needs improvement'}`}
                      class={`w-[14px] h-[8px] rounded-[2px] transition-colors ${segment.passed ? (segment.isStandout ? 'bg-[var(--ochre)]' : 'bg-[var(--moss)]') : 'bg-[var(--line)]'}`}
                    />
                  ))}
                </div>
                <span class="font-mono-data text-[0.78rem] text-[var(--ink-soft)] font-medium">
                  {tool.scorecard.filter((s) => s.passed).length}/{tool.scorecard.length}
                </span>
              </div>
              <a
                href={getHref('review', tool.slug)}
                class="inline-flex items-center gap-1.5 font-mono-data text-[0.82rem] font-semibold text-[var(--moss-dark)] hover:text-[var(--moss)] underline"
              >
                Read Review
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="w-3.5 h-3.5"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</Layout>
